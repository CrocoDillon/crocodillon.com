{
  "name": "crocodillon.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm demo:build && next dev --hostname 127.0.0.1",
    "build": "pnpm demo:build && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit && pnpm -r --if-present check-types",
    "demo:build": "node scripts/build-demos.mjs",
    "demo:sync": "node scripts/sync-codepen.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/libre-baskerville": "5.3.0",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.2",
    "@vercel/analytics": "2.0.1",
    "feed": "6.0.0",
    "gray-matter": "4.0.3",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-pretty-code": "0.14.5",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
